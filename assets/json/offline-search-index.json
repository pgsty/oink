{{- $scope := .Site.Params.offline_search_index | default "content" | lower -}}
{{- if not (in (slice "title" "heading" "summary" "content") $scope) -}}
  {{- warnf "invalid params.offline_search_index %q (allowed: title | heading | summary | content); using content" $scope -}}
  {{- $scope = "content" -}}
{{- end -}}
{{- $summaryLength := partial "validate.html" (dict
    "value" .Site.Params.offline_search_summary_length "kind" "int"
    "min" 1 "fallback" 70 "key" "params.offline_search_summary_length") -}}
{{- $.Scratch.Add "offline-search-index" slice -}}
{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- range $pages -}}
{{- if .Params.search_exclude }}{{ continue }}{{ end -}}
{{- if not .RawContent }}{{ continue }}{{ end -}}
{{- /* We have to apply `htmlUnescape` again after `truncate` because `truncate` applies `html.EscapeString` if the argument is not HTML. */ -}}
{{- /* Individual taxonomies can be added in the next line by add '"taxonomy-name" (.Params.taxonomy-name | default "")' to the dict (as seen for categories and tags). */ -}}
{{- $summary := "" -}}
{{- with .Description -}}
  {{- $summary = . | htmlUnescape | strings.TrimSpace -}}
{{- end -}}
{{- if not $summary -}}
  {{- $summary = .Summary | plainify | htmlUnescape | strings.TrimSpace -}}
{{- end -}}
{{- $headings := "" -}}
{{- if ne $scope "title" -}}
  {{- $headings = replace .TableOfContents "</a>" "</a> " | plainify | htmlUnescape | strings.TrimSpace -}}
{{- end -}}
{{- $plain := "" -}}
{{- if or (not $summary) (eq $scope "content") -}}
  {{- $plain = .Plain | htmlUnescape -}}
{{- end -}}
{{- $excerpt := $summary | default $plain -}}
{{- $metadata := partial "search/metadata.html" . -}}
{{- $doc := merge $metadata (dict
      "ref" .RelPermalink
      "title" .Title
      "categories" (.Params.categories | default "")
      "tags" (.Params.tags | default "")
      "excerpt" ($excerpt | truncate $summaryLength | htmlUnescape)
) -}}
{{- if eq $scope "heading" -}}
  {{- $doc = merge $doc (dict "headings" $headings) -}}
{{- else if eq $scope "summary" -}}
  {{- $doc = merge $doc (dict "headings" $headings "description" $summary) -}}
{{- else if eq $scope "content" -}}
  {{- $doc = merge $doc (dict
        "headings" $headings
        "description" $summary
        "body" $plain) -}}
{{- end -}}
{{- $.Scratch.Add
    "offline-search-index"
    $doc
-}}
{{- end -}}
{{- $.Scratch.Get "offline-search-index" | jsonify -}}
