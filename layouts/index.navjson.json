{{- /* Opt-in machine-readable navigation tree, one file per language at the
     language root. The tree serializes the same authority chain the sidebar
     and pager read: the explicit data/docs_nav.json tree for docs/book
     sections when it exists, the weighted content tree everywhere else, with
     child selection shared through shell/nav-children.html. Array order is
     the contract; weight is never serialized. See the agent-indexes
     proposal and schema/nav.v1.schema.json. */ -}}
{{- $home := . -}}
{{- $docsNav := index hugo.Data "docs_nav" | default dict -}}
{{- $explicitSections := index $docsNav "sections" -}}
{{- $children := slice -}}
{{- range $section := partial "shell/nav-children.html" (dict "section" $home) -}}
  {{- if and $explicitSections
        (eq $section.Kind "section")
        (in (slice "docs" "book") $section.Type) -}}
    {{- /* The explicit tree owns this section's subtree. A top-level data
         node that is the section root itself contributes its children
         rather than nesting the root inside itself -- the same root
         handling the sidebar applies. */ -}}
    {{- $rootURL := $section.RelPermalink -}}
    {{- with $home.Site.LanguagePrefix -}}
      {{- $rootURL = strings.TrimPrefix . $rootURL -}}
    {{- end -}}
    {{- $subChildren := slice -}}
    {{- range $explicitSections -}}
      {{- if eq (strings.TrimSuffix "/" (.url | default "")) (strings.TrimSuffix "/" $rootURL) -}}
        {{- range (.children | default (slice)) -}}
          {{- range partial "shell/nav-json-data-node.html" (dict "page" $home "node" .) -}}
            {{- $subChildren = $subChildren | append . -}}
          {{- end -}}
        {{- end -}}
      {{- else -}}
        {{- range partial "shell/nav-json-data-node.html" (dict "page" $home "node" .) -}}
          {{- $subChildren = $subChildren | append . -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $node := partial "shell/nav-json-page.html" (dict "page" $section) -}}
    {{- with $subChildren }}{{ $node = merge $node (dict "children" .) }}{{ end -}}
    {{- $children = $children | append $node -}}
  {{- else -}}
    {{- range partial "shell/nav-json-node.html" (dict "page" $section) -}}
      {{- $children = $children | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $root := partial "shell/nav-json-page.html" (dict "page" $home) -}}
{{- with $children }}{{ $root = merge $root (dict "children" .) }}{{ end -}}
{{- dict
  "schemaVersion" 1
  "language" $home.Site.Language.Lang
  "baseURL" $home.Site.BaseURL
  "root" $root
  | jsonify (dict "indent" "  ")
-}}
