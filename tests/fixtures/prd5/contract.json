{
  "version": 2,
  "compatibility_floor": "0.160.1",
  "release_assignments": {
    "reading_release": "0.4.0",
    "landing": "0.4.0",
    "book": "0.4.0"
  },
  "design_milestones": {
    "reading_release": "0.4.0",
    "landing": "0.5.0",
    "book": "0.6.0"
  },
  "authority": {
    "navigation": "existing_sidebar_tree",
    "landing_content": "local_data_or_inline_sections",
    "release_facts": "page_front_matter",
    "download_facts": "data_download_key",
    "book_structure": "content_tree_or_docs_nav"
  },
  "pager": {
    "default_types": [
      "docs",
      "book",
      "blog"
    ],
    "docs_book_order": "sidebar_preorder",
    "docs_root_values": [
      "section",
      "home"
    ],
    "blog_order": "time",
    "non_html": "strip"
  },
  "mathematics": {
    "passthrough_hook": true,
    "eq_escape_num_required": false,
    "eq_escape_registers_target": false,
    "runtime": false
  },
  "release": {
    "forge": "github.com",
    "fact_fields": [
      "version",
      "repo",
      "product",
      "tag",
      "date",
      "prev",
      "checksums"
    ],
    "runtime": false,
    "network_fetch": false
  },
  "download": {
    "source": "data/download/<key>.yaml",
    "channel_kinds": [
      "rolling",
      "pinned"
    ],
    "pinned_tokens": [
      "version",
      "tag"
    ],
    "rolling_interpolation": false,
    "rss": "strip"
  },
  "landing": {
    "layout": "landing",
    "sources": [
      "inline_sections",
      "data/landing/<key>",
      "data/home/<lang>"
    ],
    "runtime_flag": "hasLanding",
    "runtime_features": [
      "reveal",
      "count",
      "copy",
      "theme_image",
      "compact_menu"
    ],
    "marquee_pause": "css_checkbox",
    "marquee_duplicate": [
      "aria-hidden",
      "inert"
    ],
    "new_sections": [
      "pricing",
      "pricing-compare",
      "command-box",
      "steps",
      "timeline",
      "code-plate",
      "case-study",
      "download",
      "bar-chart"
    ],
    "localized_field_order": [
      "exact_language",
      "primary_language",
      "base"
    ],
    "network_fetch": false,
    "rss": "strip"
  },
  "book": {
    "type": "book",
    "front_matter": [
      "book_kind",
      "book_number",
      "book_part",
      "book_status"
    ],
    "numbered_components": [
      "fig",
      "tbl",
      "eq",
      "eg"
    ],
    "number_pattern": "^[0-9A-Za-z.-]+$",
    "id_pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
    "xref_kinds": [
      "fig",
      "tbl",
      "eq",
      "eg"
    ],
    "toc_depth": [
      1,
      2,
      3
    ],
    "sidebar_heading_depth": [
      2,
      3,
      4
    ],
    "whole_book_output": "print_html",
    "automatic_numbering": false,
    "pdf_epub": false,
    "native_forms": {
      "fig": "standalone_image_attribute_line",
      "tbl": "table_attribute_line",
      "eq": "passthrough_block_attribute_line",
      "eg": "fence_attributes"
    },
    "book_indexes": [
      "book-toc",
      "book-figures",
      "book-tables",
      "book-equations",
      "book-examples"
    ],
    "registration_order": "source_position",
    "removed": [
      "example",
      "book-figures kind"
    ]
  },
  "output_matrix": {
    "pager": {
      "html": "cards_and_head_rel",
      "print": "strip",
      "markdown": "strip",
      "rss": "strip"
    },
    "release_card": {
      "html": "card",
      "print": "links",
      "markdown": "links",
      "rss": "links"
    },
    "release_assets": {
      "html": "copy_table",
      "print": "static_table",
      "markdown": "pipe_table",
      "rss": "pipe_table"
    },
    "download": {
      "html": "sections",
      "print": "expanded",
      "markdown": "source",
      "rss": "strip"
    },
    "eq_escape": {
      "html": "display_math",
      "print": "display_math",
      "markdown": "tex_block",
      "rss": "tex_block"
    },
    "landing": {
      "html": "enhanced",
      "print": "static",
      "markdown": "text",
      "rss": "strip"
    },
    "xref": {
      "html": "link",
      "print": "link",
      "markdown": "relative_link",
      "rss": "relative_link"
    },
    "book_toc": {
      "html": "nested",
      "print": "nested",
      "markdown": "nested_list",
      "rss": "strip"
    },
    "fig_tbl_eq_eg": {
      "html": "figure",
      "print": "figure",
      "markdown": "labeled_source_or_native_source",
      "rss": "labeled_source_or_native_source"
    },
    "book_index": {
      "html": "ordered_list",
      "print": "ordered_list_local_links",
      "markdown": "link_list",
      "rss": "link_list"
    }
  },
  "runtime_flags": {
    "hasAssetList": "asset-list.js",
    "hasLanding": "landing.js"
  },
  "non_goals": [
    "non_github_release_forge",
    "pricing_period_toggle",
    "remote_fact_fetch",
    "image_hotspots",
    "automatic_book_numbering",
    "pdf_epub_generation",
    "archive_shell",
    "glossary_component"
  ]
}
